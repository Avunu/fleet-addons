<odoo>
    <record id="fleet_vehicle_model_merge_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.merge.form</field>
        <field name="model">fleet.vehicle.model.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Models">
                <p class="text-muted">
                    Vehicles, trims and everything else on the other models move to
                    the model you keep. The other models are then removed.
                </p>
                <group>
                    <field name="target_id" options="{'no_create': True}" />
                    <field name="model_ids" widget="many2many_tags" />
                </group>
                <footer>
                    <button
                        name="action_merge"
                        type="object"
                        string="Merge"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button special="cancel" string="Cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_model_merge" model="ir.actions.act_window">
        <field name="name">Merge Models</field>
        <field name="res_model">fleet.vehicle.model.merge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="fleet.model_fleet_vehicle_model" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('fleet.fleet_group_manager'))]" />
    </record>
</odoo>
