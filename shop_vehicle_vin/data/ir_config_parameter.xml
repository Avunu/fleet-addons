<odoo noupdate="1">
    <!-- noupdate so a site that points these at a proxy or raises the timeout
         keeps its values across module updates. -->
    <record id="param_vin_base_url" model="ir.config_parameter">
        <field name="key">shop_vehicle_vin.base_url</field>
        <field name="value">https://vpic.nhtsa.dot.gov/api/vehicles</field>
    </record>
    <record id="param_vin_timeout" model="ir.config_parameter">
        <field name="key">shop_vehicle_vin.timeout</field>
        <field name="value">20</field>
    </record>
</odoo>
